# PostgreSQL connection string for Vercel / Neon / Supabase / external PostgreSQL
# (Must start with postgresql:// or postgres:// — do NOT put a domain name like Urfoodbox.com here)
# Vercel Postgres / Neon integrations may also provide POSTGRES_URL automatically.
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/urfoodbox?sslmode=require
DATABASE_URL=""

# Optional SSL toggle for DATABASE_URL (set to "false" only for non-SSL local Postgres; defaults to "true")
DATABASE_SSL="true"

# Owner Admin Dashboard credentials (seeded on first run if no admin exists yet)
ADMIN_EMAIL="rosemyriam01@gmail.com"
ADMIN_INITIAL_PASSWORD="UrFoodBox#2026"

# Signing secret for admin session cookies (use a long random string in Vercel Env Vars)
ADMIN_SESSION_SECRET="replace-with-a-long-random-32-char-secret"

# Optional server-side Firebase Admin credentials for Vercel (ID token verification also works with projectId fallback)
# Option A: Full service account JSON string (or base64-encoded JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option B: Individual service account fields
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# APP_URL: Public URL of the deployed site
APP_URL="MY_APP_URL"
