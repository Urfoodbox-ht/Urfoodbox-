{
  "name": "urfoodbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "start": "node scripts/run-next.mjs start",
    "build": "next build && node scripts/postbuild.mjs",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "next": "^16.4.6",
    "node-domexception": "file:./vendor/node-domexception",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "node-domexception": "$node-domexception"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": false,
    "protobufjs@7.6.6": false
  }
}
