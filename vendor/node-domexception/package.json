{
  "name": "node-domexception",
  "version": "1.0.0",
  "description": "Zero-dependency shim delegating directly to Node.js native globalThis.DOMException",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
